# session transcripts hold everything said and every file read in a session - passwords,
# tokens and data.json included. keep them local.
*.jsonl
/Claude files/*.jsonl

# the dropbox app secret and any token belong nowhere in this repo. the page signs in with
# PKCE and needs only the app key, which is public and lives in dropbox-config.ts.
.env
.env.*
*.secret
*secrets*

# written by deploy_config.py in the hosted deployment, just before the image is built
/powershell_source/ao3_download_helper/hosted-settings.ini
